{
  "version": "1.0.0",
  "layout_name": "user_operator",
  "extends": "_user_base",
  "permissions": [],
  "data_sources": [
    {
      "id": "dashboard",
      "type": "api",
      "endpoint": "/api/modules/yutiv-personal_store/operator",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "params": {
        "page": "{{query.page ?? 1}}",
        "from": "{{query.from ?? \"\"}}",
        "to": "{{query.to ?? \"\"}}",
        "ledger_page": "{{query.ledger_page ?? 1}}",
        "children_page": "{{query.children_page ?? 1}}",
        "statistics_page": "{{query.statistics_page ?? 1}}"
      }
    },
    {
      "id": "catalog",
      "type": "api",
      "endpoint": "/api/modules/yutiv-personal_store/operator/catalog",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "params": {
        "search": "{{query.search ?? \"\"}}",
        "page": "{{query.catalog_page ?? 1}}"
      }
    },
    {
      "id": "categories",
      "type": "api",
      "endpoint": "/api/modules/yutiv-personal_store/operator/categories",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "params": {
        "page": "{{query.category_page ?? 1}}",
        "search": "{{query.category_search ?? \"\"}}"
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "space-y-4 p-4 md:p-8 bg-white dark:bg-gray-900 text-gray-900 dark:text-white"
        },
        "children": [
          {
            "type": "basic",
            "name": "H1",
            "text": "$t:yutiv-personal_store.store.operator"
          },
          {
            "type": "basic",
            "name": "P",
            "text": "{{dashboard.data?.store?.slug ?? \"\"}}"
          },
          {
            "type": "basic",
            "name": "Form",
            "dataKey": "filters",
            "props": {
              "id": "store-filters",
              "className": "grid gap-3 md:grid-cols-3"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "text": "$t:yutiv-personal_store.store.filters"
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "from",
                  "type": "date",
                  "placeholder": "$t:yutiv-personal_store.store.from",
                  "className": "w-full border p-2 dark:bg-gray-800"
                }
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "to",
                  "type": "date",
                  "placeholder": "$t:yutiv-personal_store.store.to",
                  "className": "w-full border p-2 dark:bg-gray-800"
                }
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "search",
                  "type": "text",
                  "placeholder": "$t:yutiv-personal_store.store.search",
                  "className": "w-full border p-2 dark:bg-gray-800"
                }
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "submit"
                },
                "text": "$t:yutiv-personal_store.store.search"
              }
            ],
            "actions": [
              {
                "type": "submit",
                "handler": "navigate",
                "params": {
                  "path": "/store-office",
                  "mergeQuery": true,
                  "query": {
                    "from": "{{_local.filters?.from ?? \"\"}}",
                    "to": "{{_local.filters?.to ?? \"\"}}",
                    "search": "{{_local.filters?.search ?? \"\"}}",
                    "page": 1,
                    "catalog_page": 1,
                    "statistics_page": 1
                  }
                }
              }
            ]
          },
          {
            "type": "basic",
            "name": "P",
            "text": "{{dashboard.data?.store?.status ?? \"\"}}"
          },
          {
            "type": "basic",
            "name": "P",
            "text": "$t:yutiv-personal_store.store.reward_notice"
          },
          {
            "type": "basic",
            "name": "Form",
            "dataKey": "applyForm",
            "props": {
              "id": "applyForm",
              "className": "space-y-3 border p-4"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "text": "$t:yutiv-personal_store.store.apply"
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "slug",
                  "type": "text",
                  "className": "w-full border p-2 bg-white dark:bg-gray-800",
                  "placeholder": "$t:yutiv-personal_store.store.slug"
                }
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "submit",
                  "className": "border px-4 py-2"
                },
                "text": "$t:yutiv-personal_store.store.save"
              }
            ],
            "actions": [
              {
                "type": "submit",
                "handler": "apiCall",
                "target": "/api/modules/yutiv-personal_store/operator",
                "params": {
                  "method": "POST",
                  "body": "{{Object.assign({}, _local.applyForm ?? {}, {\"action\":\"apply\"})}}"
                },
                "onSuccess": [
                  {
                    "handler": "refetchDataSource",
                    "params": {
                      "dataSourceId": "dashboard"
                    }
                  }
                ],
                "onError": [
                  {
                    "handler": "toast",
                    "params": {
                      "type": "error",
                      "message": "{{error.message ?? \"\"}}"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Form",
            "dataKey": "profileForm",
            "props": {
              "id": "profileForm",
              "className": "space-y-3 border p-4"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "text": "$t:yutiv-personal_store.store.profile"
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "slug",
                  "type": "text",
                  "className": "w-full border p-2 bg-white dark:bg-gray-800",
                  "placeholder": "$t:yutiv-personal_store.store.slug"
                }
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "introduction",
                  "type": "text",
                  "className": "w-full border p-2 bg-white dark:bg-gray-800",
                  "placeholder": "$t:yutiv-personal_store.store.introduction"
                }
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "logo_url",
                  "type": "text",
                  "className": "w-full border p-2 bg-white dark:bg-gray-800",
                  "placeholder": "$t:yutiv-personal_store.store.logo_url"
                }
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "banner_url",
                  "type": "text",
                  "className": "w-full border p-2 bg-white dark:bg-gray-800",
                  "placeholder": "$t:yutiv-personal_store.store.banner_url"
                }
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "submit",
                  "className": "border px-4 py-2"
                },
                "text": "$t:yutiv-personal_store.store.save"
              }
            ],
            "actions": [
              {
                "type": "submit",
                "handler": "apiCall",
                "target": "/api/modules/yutiv-personal_store/operator",
                "params": {
                  "method": "POST",
                  "body": "{{Object.assign({}, _local.profileForm ?? {}, {\"action\":\"profile\"})}}"
                },
                "onSuccess": [
                  {
                    "handler": "refetchDataSource",
                    "params": {
                      "dataSourceId": "dashboard"
                    }
                  }
                ],
                "onError": [
                  {
                    "handler": "toast",
                    "params": {
                      "type": "error",
                      "message": "{{error.message ?? \"\"}}"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Form",
            "dataKey": "includeForm",
            "props": {
              "id": "includeForm",
              "className": "space-y-3 border p-4"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "text": "$t:yutiv-personal_store.store.products"
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "product_id",
                  "type": "number",
                  "className": "w-full border p-2 bg-white dark:bg-gray-800",
                  "placeholder": "$t:yutiv-personal_store.store.product_id"
                }
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "submit",
                  "className": "border px-4 py-2"
                },
                "text": "$t:yutiv-personal_store.store.save"
              }
            ],
            "actions": [
              {
                "type": "submit",
                "handler": "apiCall",
                "target": "/api/modules/yutiv-personal_store/operator",
                "params": {
                  "method": "POST",
                  "body": "{{Object.assign({}, _local.includeForm ?? {}, {\"action\":\"products\",\"excluded\":false})}}"
                },
                "onSuccess": [
                  {
                    "handler": "refetchDataSource",
                    "params": {
                      "dataSourceId": "dashboard"
                    }
                  }
                ],
                "onError": [
                  {
                    "handler": "toast",
                    "params": {
                      "type": "error",
                      "message": "{{error.message ?? \"\"}}"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Form",
            "dataKey": "excludeForm",
            "props": {
              "id": "excludeForm",
              "className": "space-y-3 border p-4"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "text": "$t:yutiv-personal_store.store.products"
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "product_id",
                  "type": "number",
                  "className": "w-full border p-2 bg-white dark:bg-gray-800",
                  "placeholder": "$t:yutiv-personal_store.store.product_id"
                }
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "submit",
                  "className": "border px-4 py-2"
                },
                "text": "$t:yutiv-personal_store.store.save"
              }
            ],
            "actions": [
              {
                "type": "submit",
                "handler": "apiCall",
                "target": "/api/modules/yutiv-personal_store/operator",
                "params": {
                  "method": "POST",
                  "body": "{{Object.assign({}, _local.excludeForm ?? {}, {\"action\":\"products\",\"excluded\":true})}}"
                },
                "onSuccess": [
                  {
                    "handler": "refetchDataSource",
                    "params": {
                      "dataSourceId": "dashboard"
                    }
                  }
                ],
                "onError": [
                  {
                    "handler": "toast",
                    "params": {
                      "type": "error",
                      "message": "{{error.message ?? \"\"}}"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Form",
            "dataKey": "allocationForm",
            "props": {
              "id": "allocationForm",
              "className": "space-y-3 border p-4"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "text": "$t:yutiv-personal_store.store.allocation"
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "child_id",
                  "type": "number",
                  "className": "w-full border p-2 bg-white dark:bg-gray-800",
                  "placeholder": "$t:yutiv-personal_store.store.child_id"
                }
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "rate_bps",
                  "type": "number",
                  "className": "w-full border p-2 bg-white dark:bg-gray-800",
                  "placeholder": "$t:yutiv-personal_store.store.rate_bps"
                }
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "submit",
                  "className": "border px-4 py-2"
                },
                "text": "$t:yutiv-personal_store.store.save"
              }
            ],
            "actions": [
              {
                "type": "submit",
                "handler": "apiCall",
                "target": "/api/modules/yutiv-personal_store/operator",
                "params": {
                  "method": "POST",
                  "body": "{{Object.assign({}, _local.allocationForm ?? {}, {\"action\":\"allocation\"})}}"
                },
                "onSuccess": [
                  {
                    "handler": "refetchDataSource",
                    "params": {
                      "dataSourceId": "dashboard"
                    }
                  }
                ],
                "onError": [
                  {
                    "handler": "toast",
                    "params": {
                      "type": "error",
                      "message": "{{error.message ?? \"\"}}"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Form",
            "dataKey": "moveForm",
            "props": {
              "id": "moveForm",
              "className": "space-y-3 border p-4"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "text": "$t:yutiv-personal_store.store.request_move"
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "name": "parent_id",
                  "type": "number",
                  "className": "w-full border p-2 bg-white dark:bg-gray-800",
                  "placeholder": "$t:yutiv-personal_store.store.parent_id"
                }
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "submit",
                  "className": "border px-4 py-2"
                },
                "text": "$t:yutiv-personal_store.store.save"
              }
            ],
            "actions": [
              {
                "type": "submit",
                "handler": "apiCall",
                "target": "/api/modules/yutiv-personal_store/operator",
                "params": {
                  "method": "POST",
                  "body": "{{Object.assign({}, _local.moveForm ?? {}, {\"action\":\"request_move\"})}}"
                },
                "onSuccess": [
                  {
                    "handler": "refetchDataSource",
                    "params": {
                      "dataSourceId": "dashboard"
                    }
                  }
                ],
                "onError": [
                  {
                    "handler": "toast",
                    "params": {
                      "type": "error",
                      "message": "{{error.message ?? \"\"}}"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "space-y-4 p-4 md:p-8 bg-white dark:bg-gray-900 text-gray-900 dark:text-white"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "text": "$t:yutiv-personal_store.store.available"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{dashboard.data?.wallet?.available ?? 0}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "$t:yutiv-personal_store.store.debt"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{dashboard.data?.wallet?.debt ?? 0}}"
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "space-y-4 p-4 md:p-8 bg-white dark:bg-gray-900 text-gray-900 dark:text-white"
            },
            "children": [
              {
                "type": "basic",
                "name": "P",
                "text": "{{item.reference ?? \"\"}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{item.ordered_at ?? \"\"}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{item.product ?? \"\"}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{item.quantity ?? 0}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{item.payment_amount ?? 0}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{item.reward ?? 0}}"
              },
              {
                "type": "basic",
                "name": "P",
                  "text": "{{item.point_status ?? \"\"}}",
                  "if": "{{item.point_status !== 'review_required'}}"
                },
                {
                  "type": "basic",
                  "name": "P",
                  "text": "$t:yutiv-personal_store.store.review_required",
                  "if": "{{item.point_status === 'review_required'}}"
              }
            ],
            "iteration": {
              "source": "{{dashboard.data?.orders ?? []}}",
              "item_var": "item",
              "index_var": "index"
            }
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "space-y-4 p-4 md:p-8 bg-white dark:bg-gray-900 text-gray-900 dark:text-white"
            },
            "children": [
              {
                "type": "basic",
                "name": "P",
                "text": "{{dashboard.data?.total ?? 0}}"
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "border px-4 py-2 rounded-sm"
                },
                "text": "$t:yutiv-personal_store.store.previous",
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "mergeQuery": true,
                      "query": {
                        "page": "{{Math.max(1, Number(query.page ?? 1)-1)}}"
                      },
                      "path": "/store-office"
                    }
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "border px-4 py-2 rounded-sm"
                },
                "text": "$t:yutiv-personal_store.store.next",
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "mergeQuery": true,
                      "query": {
                        "page": "{{dashboard.data?.has_more ? Number(query.page ?? 1)+1 : Number(query.page ?? 1)}}"
                      },
                      "path": "/store-office"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "space-y-4 p-4 md:p-8 bg-white dark:bg-gray-900 text-gray-900 dark:text-white"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "text": "$t:yutiv-personal_store.store.ledger"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{entry.kind ?? \"\"}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{entry.amount ?? 0}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{entry.available_delta ?? 0}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{entry.debt_delta ?? 0}}"
              }
            ],
            "iteration": {
              "source": "{{dashboard.data?.ledger ?? []}}",
              "item_var": "entry",
              "index_var": "index"
            }
          },
          {
            "type": "basic",
            "name": "H2",
            "text": "$t:yutiv-personal_store.store.children"
          },
          {
            "type": "basic",
            "name": "P",
            "text": "{{dashboard.data?.descendant_count ?? 0}}"
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "space-y-4 p-4 md:p-8 bg-white dark:bg-gray-900 text-gray-900 dark:text-white"
            },
            "children": [
              {
                "type": "basic",
                "name": "P",
                "text": "{{child.slug ?? \"\"}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{child.id ?? \"\"}}"
              }
            ],
            "iteration": {
              "source": "{{dashboard.data?.children ?? []}}",
              "item_var": "child",
              "index_var": "index"
            }
          },
          {
            "type": "basic",
            "name": "H2",
            "text": "$t:yutiv-personal_store.store.catalog"
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "border-b py-4 space-y-2"
            },
            "iteration": {
              "source": "{{catalog.data?.data ?? []}}",
              "item_var": "item",
              "index_var": "index"
            },
            "children": [
              {
                "type": "basic",
                "name": "H3",
                "text": "{{item.id ?? \"\"}} · {{item.name ?? \"\"}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{item.multi_currency_selling_price?.[_global.preferredCurrency ?? _global.defaultCurrency]?.formatted ?? item.selling_price_formatted ?? ''}}"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "$t:yutiv-personal_store.store.rate_explanation"
              },
              {
                "type": "basic",
                "name": "P",
                "text": "{{item.base_rate_bps ?? 0}} / 10000 · {{item.effective_rate_per_million ?? 0}} / 1000000 · {{item.estimated_points ?? 0}} P"
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "border px-4 py-2"
                },
                "text": "$t:yutiv-personal_store.store.include",
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "target": "/api/modules/yutiv-personal_store/operator",
                    "params": {
                      "method": "POST",
                      "body": "{{({action:'products',product_id:item.id,excluded:false})}}"
                    },
                    "onSuccess": [
                      {
                        "handler": "refetchDataSource",
                        "params": {
                          "dataSourceId": "catalog"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "border px-4 py-2"
                },
                "text": "$t:yutiv-personal_store.store.exclude",
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "target": "/api/modules/yutiv-personal_store/operator",
                    "params": {
                      "method": "POST",
                      "body": "{{({action:'products',product_id:item.id,excluded:true})}}"
                    },
                    "onSuccess": [
                      {
                        "handler": "refetchDataSource",
                        "params": {
                          "dataSourceId": "catalog"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Button",
            "props": {
              "type": "button",
              "className": "border px-4 py-2"
            },
