{
    "version": "1.0.0",
    "layout_name": "shop/index",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "seo": {
            "enabled": true,
            "extensions": [
                { "type": "module", "id": "sirsoft-ecommerce" }
            ],
            "data_sources": ["products", "categories", "popularProducts", "newProducts"],
            "page_type": "shop_index",
            "toggle_setting": "$module_settings:sirsoft-ecommerce:seo.seo_shop_index",
            "vars": {
                "site_name": "$core_settings:general.site_name",
                "shopBase": "$module_settings:sirsoft-ecommerce:basic_info.route_path"
            },
            "priority": 0.7,
            "changefreq": "daily",
            "og": {
                "type": "website",
                "title": "{{_seo.shop_index.title ?? ''}}"
            },
            "structured_data": {
                "@type": "ItemList",
                "name": "{{_seo.shop_index.title ?? ''}}",
                "description": "{{_seo.shop_index.description ?? ''}}"
            }
        }
    },
    "init_actions": [
        {
            "handler": "loadFromLocalStorage",
            "params": {
                "key": "recentProductIds",
                "defaultValue": []
            },
            "resultTo": {
                "target": "_global",
                "key": "recentProductIds"
            }
        }
    ],
    "errorHandling": {
        "401": {
            "comment": "비회원 상품 조회 권한 없음 — 토스트 대신 상태 플래그로 안내 배너 표시",
            "handler": "setState",
            "params": {
                "target": "local",
                "productAccessDenied": true
            }
        },
        "403": {
            "comment": "인증된 사용자 상품 조회 권한 없음",
            "handler": "setState",
            "params": {
                "target": "local",
                "productAccessDenied": true
            }
        }
    },
    "data_sources": [
        {
            "id": "categories",
            "label_key": "$t:editor.data_source.categories",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/categories",
            "method": "GET",
            "auto_fetch": true,
            "loading_strategy": "progressive",
            "fallback": {
                "data": []
            }
        },
        {
            "id": "products",
            "label_key": "$t:editor.data_source.products",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/products",
            "method": "GET",
            "auth_mode": "optional",
            "params": {
                "page": "{{query.page ?? 1}}",
                "per_page": 12,
                "category_id": "{{query.category ?? ''}}",
                "sort": "{{query.sort ?? 'latest'}}",
                "search": "{{query.keyword ?? ''}}"
            },
            "auto_fetch": true,
            "loading_strategy": "progressive",
            "fallback": {
                "data": [],
                "meta": {
                    "current_page": 1,
                    "last_page": 1,
                    "per_page": 12,
                    "total": 0
                }
            }
        },
        {
            "id": "recentProducts",
            "label_key": "$t:editor.data_source.recentProducts",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/products/recent",
            "method": "GET",
            "auth_mode": "optional",
            "params": {
                "ids": "{{(_global.recentProductIds ?? []).join(',')}}"
            },
            "auto_fetch": true,
            "loading_strategy": "progressive",
            "fallback": {
                "data": []
            }
        },
        {
            "id": "popularProducts",
            "label_key": "$t:editor.data_source.popularProducts",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/products/popular?limit=8",
            "method": "GET",
            "auth_mode": "optional",
            "auto_fetch": true,
            "loading_strategy": "progressive",
            "fallback": {
                "data": []
            }
        },
        {
            "id": "newProducts",
            "label_key": "$t:editor.data_source.newProducts",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/products/new?limit=8",
            "method": "GET",
            "auth_mode": "optional",
            "auto_fetch": true,
            "loading_strategy": "progressive",
            "fallback": {
                "data": []
            }
        }
    ],
    "slots": {
        "content": [
            {
                "type": "layout",
                "name": "Container",
                "props": {
                    "className": "px-4 py-16 sm:px-6 lg:px-8"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mb-12"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "H1",
                                "props": {
                                    "className": "text-3xl font-light tracking-tight text-gray-900 dark:text-white lg:text-4xl"
                                },
                                "comment": "장바구니 아이콘을 뗀 순수 타이포 제목 — 상품 이미지가 화면의 중심이 되도록 헤더는 조용하게 둔다",
                                "text": "$t:shop.title"
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "props": {
                                    "className": "mt-4 max-w-xl text-sm leading-relaxed text-gray-500 dark:text-gray-400"
                                },
                                "text": "$t:shop.description"
                            }
                        ]
                    },
                    {
                        "comment": "상품 조회 권한 없음 안내 배너",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{_local.productAccessDenied === true}}",
                        "props": {
                            "className": "mb-6 p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg flex items-center gap-3"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Icon",
                                "props": {
                                    "name": "triangle-exclamation",
                                    "className": "text-yellow-600 dark:text-yellow-400"
                                }
                            },
                            {
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                    "className": "text-yellow-800 dark:text-yellow-200 text-sm"
                                },
                                "text": "$t:sirsoft-ecommerce.shop.product_access_denied"
                            }
                        ]
                    },
                    {
                        "comment": "최상위 카테고리 버튼 (전체 + 1단계 카테고리)",
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "flex flex-wrap gap-x-6 gap-y-3 mb-10" },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "className": "{{!query.category ? 'border-b border-gray-900 pb-1 text-sm font-medium text-gray-900 dark:border-white dark:text-white' : 'border-b border-transparent pb-1 text-sm text-gray-500 transition-colors hover:border-gray-900 hover:text-gray-900 dark:text-gray-400 dark:hover:border-gray-200 dark:hover:text-white'}}"
                                },
                                "text": "$t:shop.category.all",
                                "actions": [
                                    { "comment": "audit:allow layout-list-context-navigate-merge-query 카테고리 '전체' 선택 — 카테고리 필터를 푸는 의도적 리셋이므로 병합하지 않는다", "type": "click", "handler": "navigate", "params": { "path": "{{_global.shopBase}}/products", "query": {} } }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "Div",
                                "iteration": { "source": "{{categories?.data ?? []}}", "item_var": "cat" },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Button",
                                        "props": {
                                            "className": "{{query.category == cat?.id ? 'border-b border-gray-900 pb-1 text-sm font-medium text-gray-900 dark:border-white dark:text-white' : 'border-b border-transparent pb-1 text-sm text-gray-500 transition-colors hover:border-gray-900 hover:text-gray-900 dark:text-gray-400 dark:hover:border-gray-200 dark:hover:text-white'}}"
                                        },
                                        "text": "{{cat?.name_localized}}",
                                        "actions": [
                                            { "comment": "audit:allow layout-list-context-navigate-merge-query 카테고리 전환 — 다른 목록으로의 이동이라 이전 카테고리의 검색·정렬 상태를 승계하지 않는다", "type": "click", "handler": "navigate", "params": { "path": "{{_global.shopBase}}/products", "query": { "category": "{{cat?.id}}", "page": "1" } } }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "partial": "partials/shop/list/_search_filter_bar.json"
                    },
                    {
                        "partial": "partials/shop/list/_product_grid.json"
                    },
                    {
                        "partial": "partials/shop/list/_recent_products.json"
                    },
                    {
                        "partial": "partials/shop/list/_popular_products.json"
                    },
                    {
                        "partial": "partials/shop/list/_new_products.json"
                    }
                ]
            }
        ]
    }
}
